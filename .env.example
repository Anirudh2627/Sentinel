# ---------------------------------------------------------------------------
# Sentinel environment configuration — copy to .env and adjust.
# Every variable is OPTIONAL; sane local defaults live in configs/*.yaml.
# Nested overrides use the SENTINEL_<SECTION>__<KEY> convention, e.g.
# SENTINEL_SERVING__PORT=9000 overrides serving.port in the YAML config.
# ---------------------------------------------------------------------------

# Active configuration profile: development | production
SENTINEL_ENV=development

# --- Experiment tracking (MLflow) -------------------------------------------
# Backend: auto (mlflow if importable, else local) | mlflow | local | none
SENTINEL_EXPERIMENT_TRACKING__BACKEND=auto
# Local file store by default; point at a server (e.g. http://localhost:5000)
# when running the docker-compose stack.
SENTINEL_EXPERIMENT_TRACKING__MLFLOW__TRACKING_URI=

# --- Serving ----------------------------------------------------------------
SENTINEL_SERVING__HOST=0.0.0.0
SENTINEL_SERVING__PORT=8000
# Token required for /admin/* endpoints. Leave unset in local development;
# ALWAYS set in shared/production environments. Never commit a real token.
SENTINEL_SERVING__ADMIN_TOKEN=

# --- Deployment controller ---------------------------------------------------
SENTINEL_ROLLBACK__ENABLED=true

# --- Fault injection (demo only — keep disabled by default) -------------------
SENTINEL_FAULTS__ENABLED=false
SENTINEL_FAULTS__LATENCY_MS=0
SENTINEL_FAULTS__ERROR_RATE=0.0

# --- Simulation ---------------------------------------------------------------
SENTINEL_SIMULATION__BASE_URL=http://localhost:8000
